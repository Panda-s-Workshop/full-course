{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "https://panda-s-workshop.github.io/full-course/",
    "sources": "https://github.com/Panda-s-Workshop/full-course",
    "issues": "https://github.com/Panda-s-Workshop/full-course/issues"
  },
  "license": "${mod_license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.panda.fullcourse.fabric.FullCourseFabric"
    ],
    "client": [
      "com.panda.fullcourse.fabric.client.FullCourseFabricClient"
    ],
    "appleskin": [
      "com.panda.fullcourse.fabric.client.compat.AppleSkinCompat"
    ],
    "jei_mod_plugin": [
      "com.panda.fullcourse.client.compat.jei.FullCourseJeiPlugin"
    ]
  },
  "accessWidener": "fullcourse.accesswidener",
  "mixins": [
    "fullcourse.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_min}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25"
  },
  "suggests": {
    "appleskin": "*",
    "farmersdelight": "*",
    "jei": "*"
  }
}
